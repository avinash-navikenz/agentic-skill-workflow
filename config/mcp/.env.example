# navi-delivery — MCP connection variables.
#
# Copy to a file your shell sources (never into the repository) and fill in.
# Every ${NAME} in config/mcp/*.mcp.json appears here; scripts/validate_mcp_configs.py
# fails if one does not.
#
# Nothing here is read by the navi CLI. These are the variables the MCP servers
# themselves read, expanded by the harness when it launches the server.

# --- Atlassian Cloud, API-token route (config/mcp/atlassian-cloud-token.mcp.json) ---
# The OAuth route (atlassian-cloud.mcp.json) needs none of these.
JIRA_URL=https://your-company.atlassian.net
JIRA_USERNAME=you@your-company.com
JIRA_API_TOKEN=
CONFLUENCE_URL=https://your-company.atlassian.net/wiki
CONFLUENCE_USERNAME=you@your-company.com
CONFLUENCE_API_TOKEN=

# --- Azure DevOps (config/mcp/azure-devops.mcp.json) ---
# The organization is the name only, not the URL: `contoso`, not
# `https://dev.azure.com/contoso`. Authentication is your existing `az login`
# session — there is no token variable.
ADO_ORGANIZATION=
ADO_PROJECT=

# --- GitHub, local container route (config/mcp/github-local.mcp.json) ---
# The hosted route (github.mcp.json) authenticates in the browser and needs none.
GITHUB_PERSONAL_ACCESS_TOKEN=
